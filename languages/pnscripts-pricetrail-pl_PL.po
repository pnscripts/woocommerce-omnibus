#: src/Admin/SettingsPage.php:405
msgid "For each one: whether the lowest prior price is known and shown, and if not, why."
msgstr "Dla każdego z nich: czy najniższa cena sprzed obniżki jest znana i wyświetlana, a jeśli nie – dlaczego."

