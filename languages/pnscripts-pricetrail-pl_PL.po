msgstr "Omnibus by iLabs"

#. translators: %s: minimum WooCommerce version
#: src/Plugin.php:263
#, php-format
msgid "Pricetrail needs WooCommerce %s or newer to be active."
msgstr "Pricetrail wymaga aktywnej wtyczki WooCommerce w wersji %s lub nowszej."

#: src/Settings.php:128
msgid "EU, strict: 30 days, no optional exemptions"
msgstr "UE, ściśle: 30 dni, bez opcjonalnych wyłączeń"

#: src/Settings.php:129
msgid "Bulgaria: 30 days, no optional exemptions"
msgstr "Bułgaria: 30 dni, bez opcjonalnych wyłączeń"

#: src/Settings.php:130
msgid "Germany: 30 days, perishable goods may be excluded"
msgstr "Niemcy: 30 dni, towary szybko psujące się mogą być wyłączone"

#: src/Settings.php:131
msgid "Poland: 30 days, products offered for less than 30 days use the period since launch"
msgstr "Polska: 30 dni, dla produktów oferowanych krócej niż 30 dni stosuje się okres od rozpoczęcia sprzedaży"

#: src/Settings.php:132
msgid "Custom rules"
msgstr "Własne zasady"
