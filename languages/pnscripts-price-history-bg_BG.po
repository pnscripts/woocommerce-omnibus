#. Plugin Name of the plugin
#: pnscripts-price-history.php
msgid "PN Scripts Price History for Discounts"
msgstr "PN Scripts Price History за намаления"

#. Plugin URI of the plugin
#: pnscripts-price-history.php
msgid "https://pnscripts.com/marketplace/pn-omnibus"
msgstr "https://pnscripts.com/marketplace/pn-omnibus"

#. Description of the plugin
#: pnscripts-price-history.php
msgid "Records every product and variation price change and shows the lowest price in the 30 days before a discount (EU Price Indication Directive, Art. 6a). Shows nothing when the history is incomplete."
msgstr "Записва всяка промяна в цената на продуктите и вариациите и показва най-ниската цена през 30-те дни преди намалението (Директива за обозначаване на цените, чл. 6а). Не показва нищо, когато историята е непълна."

#. Author of the plugin
#: pnscripts-price-history.php
msgid "PN Scripts"
msgstr "PN Scripts"

#. Author URI of the plugin
#: pnscripts-price-history.php
msgid "https://pnscripts.com"
msgstr "https://pnscripts.com"

